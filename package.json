{
  "name": "crow",
  "version": "1.0.0",
  "description": "Deterministic Node.js backend code synthesis engine",
  "license": "MIT",
  "keywords": [
    "codegen",
    "nodejs",
    "cli",
    "backend",
    "express",
    "fastify"
  ],
  "main": "core/pipeline.js",
  "bin": {
    "crow": "./cli/index.js"
  },
  "files": [
    "cli",
    "core",
    "configs",
    "patterns",
    "generated",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node cli/index.js --help",
    "start": "node cli/index.js",
    "seed": "node patterns/seed.js",
    "lint": "eslint core cli scripts tests --ext .js",
    "test": "jest --coverage --forceExit",
    "validate": "node scripts/validate.js",
    "clean": "npm run clean:coverage && npm run clean:generated",
    "clean:coverage": "rimraf coverage",
    "clean:generated": "rimraf generated/test_output"
  },
  "dependencies": {
    "@babel/generator": "^7.23.6",
    "@babel/parser": "^7.23.6",
    "@babel/types": "^7.23.6",
    "commander": "^11.1.0",
    "js-yaml": "^4.1.0",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "prettier": "^3.1.1"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "rimraf": "^6.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/girish-kor/crow.git"
  },
  "bugs": {
    "url": "https://github.com/girish-kor/crow/issues"
  },
  "homepage": "https://github.com/girish-kor/crow#readme"
}
